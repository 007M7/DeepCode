{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // Single-program spike: vendor srcs are checked under THIS program's flags
    // (no project references), so relax the union of vendor tsconfig
    // relaxations. A production browser program must pick one of: same
    // relaxation, consuming vendor lib/types instead of src, or references.
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictFunctionTypes": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // "paths" overrides the base map wholesale; redeclare (relative to poc/).
    "paths": {
      "cordis": ["../../../../vendor/cordis/src"],
      "cosmokit": ["../../../../vendor/cosmokit/src"],
      "@cordisjs/plugin-timer": ["../../../../vendor/timer/src"],
      "@deepseek-ai/dsh-host-apiproxy": ["../../../../packages/host/apiproxy/src"],
      "@deepseek-ai/dsh-host-apiproxy/*": ["../../../../packages/host/apiproxy/src/*"],
      "@deepseek-ai/dsh-*": [
        "../../../../packages/core/*/src",
        "../../../../packages/llm/*/src",
        "../../../../packages/ui/*/src",
        "../../../../packages/util/*/src",
        "../../../../packages/session-persistence/*/src"
      ]
    }
  }
}
